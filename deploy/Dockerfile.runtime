# The Linux binary is built and tested on the deployment workstation.
FROM alpine:3.23
RUN apk add --no-cache ca-certificates tzdata && addgroup -g 10001 app && adduser -D -u 10001 -G app app
WORKDIR /app
COPY tksu-pl /app/tksu-pl
RUN chmod 755 /app/tksu-pl
USER 10001:10001
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 CMD wget -q -O /dev/null http://127.0.0.1:8080/ping || exit 1
ENTRYPOINT ["/app/tksu-pl"]
